# ---------------------------------------------------------------
# Thinkswell Ads Dashboard: environment variables
# Copy to .env.local for local dev. Set the same keys in Vercel.
# ---------------------------------------------------------------

# Postgres connection string. Leave empty locally to use the embedded
# PGlite database in .data/ (zero setup). In production use Supabase's
# *Shared Pooler* (Supavisor) transaction-mode URL (port 6543). Not the direct
# connection or Dedicated Pooler: those use db.<ref>.supabase.co, which is
# IPv6-only and unreachable from Vercel. e.g.
# postgresql://postgres.<ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=
# Connections to remote databases are encrypted. Set to "disable" only for a
# database that doesn't support SSL.
DATABASE_SSL=

# Signs session cookies. Required in production: `openssl rand -base64 48`
AUTH_SECRET=

# Windsor.ai API key (Windsor → Settings → API key). Without it the app
# runs on generated demo data.
WINDSOR_API_KEY=

# Optional: Meta attribution window, passed through Windsor.
# e.g. 7d_click,1d_view (Meta's default when unset)
WINDSOR_ATTRIBUTION_WINDOW=

# Days re-pulled on each scheduled sync (late conversions keep landing).
SYNC_LOOKBACK_DAYS=7

# Vercel Cron sends this as a Bearer token to /api/cron/sync.
CRON_SECRET=

# Reporting timezone for "today", greetings and date presets.
APP_TIMEZONE=America/Chicago

# Primary public URL, used in invite / reset links. In production, visits to the
# *.vercel.app address redirect here. Production: https://advertising.thinkswell.com
APP_URL=

# Optional: email invite links automatically via Resend.
RESEND_API_KEY=
EMAIL_FROM="Thinkswell <dashboards@thinkswell.com>"

# First admin created by `npm run db:seed` (production).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
